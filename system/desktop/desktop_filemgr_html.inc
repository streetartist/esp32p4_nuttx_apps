  "<!doctype html>\n"
  "<html lang=\"zh-CN\">\n"
  "<head>\n"
  "<meta charset=\"utf-8\">\n"
  "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n"
  "<title>NuttX 文件管理</title>\n"
  "<style>\n"
  ":root{color-scheme:light dark;--bg:#f4f6f9;--panel:#fff;--text:#172033;\n"
  "--muted:#687386;--line:#d9dee7;--blue:#3659c9;--danger:#c83d4b}\n"
  "@media(prefers-color-scheme:dark){:root{--bg:#101521;--panel:#171e2c;\n"
  "--text:#f4f6fb;--muted:#9ba6ba;--line:#303a4d;--blue:#7890ee;\n"
  "--danger:#ef7180}}\n"
  "*{box-sizing:border-box}\n"
  "body{margin:0;background:var(--bg);color:var(--text);font:15px system-ui,sans-serif}\n"
  "header{height:58px;display:flex;align-items:center;justify-content:space-between;\n"
  "padding:0 24px;background:var(--panel);border-bottom:1px solid var(--line)}\n"
  "h1{font-size:19px;margin:0;letter-spacing:0}\n"
  ".status{color:var(--muted);font-size:13px}\n"
  "main{max-width:980px;margin:22px auto;padding:0 18px}\n"
  ".toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}\n"
  ".path{flex:1;min-width:220px;padding:9px 11px;background:var(--panel);\n"
  "border:1px solid var(--line);border-radius:6px;overflow:hidden;text-overflow:ellipsis}\n"
  "button,.upload{border:1px solid var(--line);background:var(--panel);color:var(--text);\n"
  "padding:9px 13px;border-radius:6px;cursor:pointer;font:inherit}\n"
  "button:hover,.upload:hover{border-color:var(--blue)}\n"
  ".primary{background:var(--blue);border-color:var(--blue);color:#fff}\n"
  ".upload input{display:none}\n"
  ".hint{width:100%;color:var(--muted);font-size:12px;margin:-4px 0 8px}\n"
  ".table{background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow:hidden}\n"
  ".row{display:grid;grid-template-columns:minmax(180px,1fr) 100px 160px;align-items:center;\n"
  "min-height:52px;padding:0 14px;border-bottom:1px solid var(--line);gap:12px}\n"
  ".row:last-child{border-bottom:0}\n"
  ".name{display:flex;gap:10px;align-items:center;min-width:0}\n"
  ".name button{border:0;padding:4px;background:transparent;color:var(--text);\n"
  "overflow:hidden;text-overflow:ellipsis;text-align:left;white-space:nowrap}\n"
  ".kind{width:28px;color:var(--muted);font-size:12px}\n"
  ".size{color:var(--muted);font-variant-numeric:tabular-nums}\n"
  ".actions{display:flex;justify-content:flex-end;gap:6px}\n"
  ".actions button{padding:6px 9px;font-size:13px}\n"
  ".danger{color:var(--danger)}\n"
  ".empty{padding:48px;text-align:center;color:var(--muted)}\n"
  ".message{min-height:24px;margin-top:12px;color:var(--muted)}\n"
  ".progress{display:block;width:100%;height:8px;accent-color:var(--blue)}\n"
  ".progress[hidden]{display:none}\n"
  "@media(max-width:620px){header{padding:0 16px}.row{grid-template-columns:1fr auto}\n"
  ".size{display:none}.actions{grid-column:1/-1;justify-content:flex-start;padding-bottom:10px}}\n"
  "</style>\n"
  "</head>\n"
  "<body>\n"
  "<header><h1>NuttX 文件管理</h1><span class=\"status\">/data</span></header>\n"
  "<main>\n"
  "<div class=\"toolbar\">\n"
  "<button id=\"up\">上一级</button>\n"
  "<div class=\"path\" id=\"path\">/</div>\n"
  "<button id=\"mkdir\">新建目录</button>\n"
  "<label class=\"upload\">上传文件<input id=\"files\" type=\"file\" multiple></label>\n"
  "<label class=\"upload primary\">上传 zip/rpk/qpk<input id=\"packs\" type=\"file\" accept=\".zip,.rpk,.qpk,application/zip\"></label>\n"
  "</div>\n"
  "<div class=\"hint\">zip / rpk / qpk 在浏览器里解压后再写入设备，芯片不做解压缩。删除目录会递归清掉里面的全部文件，可用来卸载已安装的快应用。</div>\n"
  "<div class=\"table\" id=\"list\"></div>\n"
  "<div class=\"message\" id=\"message\"></div>\n"
  "<progress class=\"progress\" id=\"progress\" max=\"100\" value=\"0\" hidden></progress>\n"
  "</main>\n"
  "<script>\n"
  "const qs=new URLSearchParams(location.search);\n"
  "let key=qs.get('key')||sessionStorage.getItem('fmkey')||'';\n"
  "if(!key){key=prompt('请输入设备上显示的访问码')||''}\n"
  "if(key)sessionStorage.setItem('fmkey',key);\n"
  "let path='/',freeBytes=null,knownFiles=new Map();\n"
  "const list=document.getElementById('list');\n"
  "const msg=document.getElementById('message');\n"
  "const pathEl=document.getElementById('path');\n"
  "const progress=document.getElementById('progress');\n"
  "const maxName=" FM_STRINGIFY(CONFIG_NAME_MAX) ";\n"
  "function api(route,p){\n"
  "  const q=new URLSearchParams(p||{});\n"
  "  q.set('key',key);\n"
  "  return route+'?'+q;\n"
  "}\n"
  "function join(a,b){return(a==='/'?'':a)+'/'+b}\n"
  "function size(n){\n"
  "  if(n<1024)return n+' B';\n"
  "  if(n<1048576)return(n/1024).toFixed(1)+' KB';\n"
  "  return(n/1048576).toFixed(1)+' MB';\n"
  "}\n"
  "function el(tag,cls,text){\n"
  "  const n=document.createElement(tag);\n"
  "  if(cls)n.className=cls;\n"
  "  if(text!==undefined)n.textContent=text;\n"
  "  return n;\n"
  "}\n"
  "async function request(url,opt){\n"
  "  const r=await fetch(url,opt);\n"
  "  if(!r.ok){\n"
  "    let t=await r.text();\n"
  "    throw new Error(t||('HTTP '+r.status));\n"
  "  }\n"
  "  return r;\n"
  "}\n"
  "function message(t,bad){\n"
  "  msg.textContent=t;\n"
  "  msg.style.color=bad?'var(--danger)':'';\n"
  "}\n"
  "async function refresh(){\n"
  "  message('正在读取目录');\n"
  "  try{\n"
  "    const r=await request(api('/api/list',{path}));\n"
  "    const data=await r.json();\n"
  "    pathEl.textContent=data.path;\n"
  "    freeBytes=Number.isFinite(data.free)?data.free:null;\n"
  "    knownFiles=new Map(data.items.filter(x=>!x.dir).map(x=>[x.name,x.size]));\n"
  "    list.replaceChildren();\n"
  "    if(!data.items.length)list.append(el('div','empty','此目录为空'));\n"
  "    for(const item of data.items){\n"
  "      const row=el('div','row');\n"
  "      const name=el('div','name');\n"
  "      name.append(el('span','kind',item.dir?'目录':'文件'));\n"
  "      const open=el('button','',item.name);\n"
  "      open.onclick=()=>item.dir?openDir(item.name):download(item.name);\n"
  "      name.append(open);\n"
  "      row.append(name,el('div','size',item.dir?'--':size(item.size)));\n"
  "      const actions=el('div','actions');\n"
  "      if(!item.dir){\n"
  "        const d=el('button','','下载');\n"
  "        d.onclick=()=>download(item.name);\n"
  "        actions.append(d);\n"
  "      }\n"
  "      const del=el('button','danger','删除');\n"
  "      del.onclick=()=>removeItem(item);\n"
  "      actions.append(del);\n"
  "      row.append(actions);\n"
  "      list.append(row);\n"
  "    }\n"
  "    message(data.items.length+' 个项目'+(freeBytes===null?'':' · 可用 '+size(freeBytes)));\n"
  "  }catch(e){\n"
  "    list.replaceChildren();\n"
  "    list.append(el('div','empty','无法读取目录'));\n"
  "    message(e.message,true);\n"
  "  }\n"
  "}\n"
  "function openDir(n){path=join(path,n);refresh()}\n"
  "function download(n){\n"
  "  const a=document.createElement('a');\n"
  "  a.href=api('/api/download',{path:join(path,n)});\n"
  "  a.download=n;\n"
  "  a.click();\n"
  "}\n"
  "async function removeItem(item){\n"
  "  const hint=item.dir\n"
  "    ?'确定删除目录 '+item.name+' 及其全部内容？不可恢复。'\n"
  "    :'确定删除 '+item.name+'？';\n"
  "  if(!confirm(hint))return;\n"
  "  try{\n"
  "    await request(api('/api/delete',{path:join(path,item.name)}),{method:'DELETE'});\n"
  "    await refresh();\n"
  "  }catch(e){message(e.message,true)}\n"
  "}\n"
  "document.getElementById('up').onclick=()=>{\n"
  "  if(path==='/')return;\n"
  "  const i=path.lastIndexOf('/');\n"
  "  path=i<=0?'/':path.slice(0,i);\n"
  "  refresh();\n"
  "};\n"
  "document.getElementById('mkdir').onclick=async()=>{\n"
  "  const name=prompt('目录名称');\n"
  "  if(!name)return;\n"
  "  try{\n"
  "    await request(api('/api/mkdir',{path:join(path,name)}),{method:'POST'});\n"
  "    await refresh();\n"
  "  }catch(e){message(e.message,true)}\n"
  "};\n"
  "function upload(file, destPath){\n"
  "  const target=destPath||join(path,file.name);\n"
  "  return new Promise((ok,fail)=>{\n"
  "    const x=new XMLHttpRequest();\n"
  "    x.open('PUT',api('/api/upload',{path:target}));\n"
  "    x.upload.onprogress=e=>{\n"
  "      if(e.lengthComputable){\n"
  "        const n=Math.round(e.loaded*100/e.total);\n"
  "        progress.hidden=false;\n"
  "        progress.value=n;\n"
  "        message('正在上传 '+(destPath||file.name)+' · '+n+'%');\n"
  "      }\n"
  "    };\n"
  "    x.onload=()=>x.status>=200&&x.status<300?ok():fail(new Error(x.responseText||('HTTP '+x.status)));\n"
  "    x.onerror=()=>fail(new Error('上传连接中断'));\n"
  "    x.onabort=()=>fail(new Error('上传已取消'));\n"
  "    x.send(file);\n"
  "  });\n"
  "}\n"
  "function isPack(file){return /\\.(zip|rpk|qpk)$/i.test(file.name)}\n"
  "function u16(v,o){return v[o]|v[o+1]<<8}\n"
  "function u32(v,o){return (v[o]|v[o+1]<<8|v[o+2]<<16|v[o+3]<<24)>>>0}\n"
  "function skipEntry(name){\n"
  "  const n=name.replace(/\\\\/g,'/');\n"
  "  const base=n.split('/').pop();\n"
  "  if(!base||base==='.DS_Store'||base==='Thumbs.db')return true;\n"
  "  if(n==='__MACOSX'||n.startsWith('__MACOSX/')||n.includes('/__MACOSX/'))return true;\n"
  "  return false;\n"
  "}\n"
  "async function inflateRaw(bytes){\n"
  "  if(typeof DecompressionStream!=='function'){\n"
  "    throw new Error('当前浏览器无法解压 zip，请使用 Chrome / Edge / 新版 Safari');\n"
  "  }\n"
  "  const out=await new Response(new Blob([bytes]).stream().pipeThrough(\n"
  "    new DecompressionStream('deflate-raw'))).arrayBuffer();\n"
  "  return new Uint8Array(out);\n"
  "}\n"
  "async function unzip(buf){\n"
  "  const v=new Uint8Array(buf);\n"
  "  let eocd=-1;\n"
  "  const min=Math.max(0,v.length-22-65535);\n"
  "  for(let i=v.length-22;i>=min;i--){\n"
  "    if(v[i]===0x50&&v[i+1]===0x4b&&v[i+2]===0x05&&v[i+3]===0x06){eocd=i;break}\n"
  "  }\n"
  "  if(eocd<0)throw new Error('不是有效的 zip / rpk / qpk');\n"
  "  const count=u16(v,eocd+10);\n"
  "  let off=u32(v,eocd+16);\n"
  "  if(count===0xffff||off===0xffffffff)throw new Error('暂不支持 ZIP64 压缩包');\n"
  "  const files=[];\n"
  "  for(let i=0;i<count;i++){\n"
  "    if(u32(v,off)!==0x02014b50)throw new Error('压缩包目录损坏');\n"
  "    const flags=u16(v,off+8);\n"
  "    const method=u16(v,off+10);\n"
  "    const csz=u32(v,off+20);\n"
  "    const nlen=u16(v,off+28);\n"
  "    const xlen=u16(v,off+30);\n"
  "    const clen=u16(v,off+32);\n"
  "    const local=u32(v,off+42);\n"
  "    const name=new TextDecoder().decode(v.subarray(off+46,off+46+nlen)).replace(/\\\\/g,'/');\n"
  "    off+=46+nlen+xlen+clen;\n"
  "    if(!name||name.endsWith('/')||skipEntry(name))continue;\n"
  "    if(flags&1)throw new Error('不支持加密压缩包');\n"
  "    if(u32(v,local)!==0x04034b50)throw new Error('压缩包条目损坏：'+name);\n"
  "    const ln=u16(v,local+26),lx=u16(v,local+28);\n"
  "    const data=v.subarray(local+30+ln+lx,local+30+ln+lx+csz);\n"
  "    let raw;\n"
  "    if(method===0)raw=data;\n"
  "    else if(method===8)raw=await inflateRaw(data);\n"
  "    else throw new Error('不支持的压缩方式（'+method+'）：'+name);\n"
  "    files.push({name:name.replace(/^\\/+/,''),data:raw});\n"
  "  }\n"
  "  return files;\n"
  "}\n"
  "function withManifestPrefix(files){\n"
  "  const direct=files.find(f=>f.name==='manifest.json');\n"
  "  if(direct)return files;\n"
  "  const nested=files.find(f=>/^[^/]+\\/manifest.json$/.test(f.name));\n"
  "  if(!nested)return files;\n"
  "  const prefix=nested.name.slice(0,nested.name.indexOf('/')+1);\n"
  "  if(!files.every(f=>f.name.startsWith(prefix)))return files;\n"
  "  return files.map(f=>({name:f.name.slice(prefix.length),data:f.data})).filter(f=>f.name);\n"
  "}\n"
  "function safeId(s){\n"
  "  return String(s||'').toLowerCase().replace(/[^a-z0-9._-]+/g,'-').replace(/^[-.]+|[-.]+$/g,'').slice(0,32);\n"
  "}\n"
  "function packDest(files,filename){\n"
  "  const ready=withManifestPrefix(files);\n"
  "  const manifest=ready.find(f=>f.name==='manifest.json');\n"
  "  if(!manifest){\n"
  "    return {files:files,dest:path,app:false};\n"
  "  }\n"
  "  let id='';\n"
  "  try{\n"
  "    const parsed=JSON.parse(new TextDecoder().decode(manifest.data));\n"
  "    id=safeId(parsed.name)||safeId((parsed.package||'').split('.').pop());\n"
  "  }catch(err){}\n"
  "  if(!id)id=safeId(filename.replace(/\\.(zip|rpk|qpk)$/i,''));\n"
  "  return {files:ready,dest:'/qpk/'+(id||'app'),app:true};\n"
  "}\n"
  "function checkRel(rel){\n"
  "  const parts=rel.split('/').filter(Boolean);\n"
  "  if(!parts.length)throw new Error('无效路径');\n"
  "  for(const part of parts){\n"
  "    if(part==='.'||part==='..')throw new Error('无效路径：'+rel);\n"
  "    if(new Blob([part]).size>maxName)throw new Error('文件名过长：'+part+'（设备最多 '+maxName+' 字节）');\n"
  "  }\n"
  "}\n"
  "async function mkdirp(dir){\n"
  "  if(!dir||dir==='/')return;\n"
  "  const parts=dir.split('/').filter(Boolean);\n"
  "  let cur='';\n"
  "  for(const part of parts){\n"
  "    cur+='/'+part;\n"
  "    const r=await fetch(api('/api/mkdir',{path:cur}),{method:'POST'});\n"
  "    if(r.ok||r.status===409)continue;\n"
  "    const t=await r.text();\n"
  "    throw new Error(t||('无法创建目录 '+cur));\n"
  "  }\n"
  "}\n"
  "async function unpackAndUpload(file){\n"
  "  message('正在解压 '+file.name+'（浏览器本地，设备不解压）');\n"
  "  progress.hidden=false;\n"
  "  progress.value=0;\n"
  "  const unpacked=await unzip(await file.arrayBuffer());\n"
  "  if(!unpacked.length)throw new Error('压缩包里没有可写入的文件');\n"
  "  const spec=packDest(unpacked,file.name);\n"
  "  for(const item of spec.files)checkRel(item.name);\n"
  "  const need=spec.files.reduce((sum,item)=>sum+item.data.byteLength,0);\n"
  "  if(freeBytes!==null&&need>freeBytes){\n"
  "    throw new Error('存储空间不足：需要 '+size(need)+'，当前可用 '+size(freeBytes));\n"
  "  }\n"
  "  await mkdirp(spec.dest);\n"
  "  const dirs=new Set();\n"
  "  for(const item of spec.files){\n"
  "    const slash=item.name.lastIndexOf('/');\n"
  "    if(slash>0)dirs.add(join(spec.dest,item.name.slice(0,slash)));\n"
  "  }\n"
  "  for(const dir of [...dirs].sort())await mkdirp(dir);\n"
  "  for(let i=0;i<spec.files.length;i++){\n"
  "    const item=spec.files[i];\n"
  "    const blob=new Blob([item.data]);\n"
  "    progress.value=Math.round(i*100/spec.files.length);\n"
  "    message('正在上传 '+item.name+'（'+(i+1)+'/'+spec.files.length+'）');\n"
  "    await upload(blob,join(spec.dest,item.name));\n"
  "  }\n"
  "  path=spec.dest;\n"
  "  message((spec.app?'已安装应用 ':'已解压 ')+file.name+' → '+spec.dest+'（'+spec.files.length+' 个文件）');\n"
  "}\n"
  "async function handleFiles(fileList){\n"
  "  const files=[...fileList];\n"
  "  if(!files.length)return;\n"
  "  for(const file of files){\n"
  "    const n=new Blob([file.name]).size;\n"
  "    if(n>maxName){\n"
  "      throw new Error('文件名过长：'+n+' 字节，设备最多支持 '+maxName+' 字节（中文通常每字 3 字节）');\n"
  "    }\n"
  "  }\n"
  "  if(freeBytes!==null){\n"
  "    let budget=freeBytes;\n"
  "    for(const file of files){\n"
  "      if(isPack(file))continue;\n"
  "      const old=knownFiles.get(file.name)||0;\n"
  "      if(file.size>budget+old){\n"
  "        throw new Error('存储空间不足：'+file.name+' 需要 '+size(file.size)+'，当前可用 '+size(budget+old));\n"
  "      }\n"
  "      budget+=old-file.size;\n"
  "    }\n"
  "  }\n"
  "  progress.value=0;\n"
  "  progress.hidden=false;\n"
  "  for(const file of files){\n"
  "    if(isPack(file))await unpackAndUpload(file);\n"
  "    else await upload(file);\n"
  "  }\n"
  "}\n"
  "function bindInput(id){\n"
  "  document.getElementById(id).onchange=async e=>{\n"
  "    try{\n"
  "      await handleFiles(e.target.files);\n"
  "      await refresh();\n"
  "    }catch(err){\n"
  "      message(err.message,true);\n"
  "    }finally{\n"
  "      e.target.value='';\n"
  "      progress.hidden=true;\n"
  "    }\n"
  "  };\n"
  "}\n"
  "bindInput('files');\n"
  "bindInput('packs');\n"
  "refresh();\n"
  "</script>\n"
  "</body>\n"
  "</html>\n"
